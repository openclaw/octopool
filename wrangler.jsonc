{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "octopool",
  "account_id": "91b59577e757131d68d55a471fe32aca",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ALLOWED_GITHUB_ORG": "openclaw",
    "PUBLIC_REPO_TTL_SECONDS": "900",
    "PUBLIC_REPO_NEGATIVE_TTL_SECONDS": "3600",
    "DEFAULT_ALLOWED_OWNERS": "openclaw",
    "MAX_RESPONSE_BYTES": "4194304",
    "REQUEST_TIMEOUT_MS": "15000",
    "ORG_VERIFY_TTL_SECONDS": "86400",
    "GITHUB_OAUTH_CLIENT_ID": "Iv23lilUVXPNTPhNhUmZ",
    "GITHUB_OAUTH_CALLBACK_ORIGIN": "https://octopool.dev",
  },
  "workers_dev": true,
  "routes": [{ "pattern": "octopool.openclaw.ai", "custom_domain": true }],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "octopool-wnam",
      "database_id": "a4b252b5-2553-4896-b33a-14689a2152be",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ACTIONS_LOGS",
      "bucket_name": "octopool-actions-logs",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POOL_COORDINATOR",
        "class_name": "PoolCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PoolCoordinator"],
    },
  ],
}
